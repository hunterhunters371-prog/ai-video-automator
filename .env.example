# ===== LLM (obligatorio: rellena UNO y ajusta LLM_PROVIDER) =====
# Gratis sin tarjeta: github | hf | pollinations — de pago: openai | anthropic
LLM_PROVIDER=github
GITHUB_MODELS_TOKEN=           # gratis: github.com/settings/tokens
HF_TOKEN=                      # gratis: huggingface.co/settings/tokens — además activa imágenes IA
POLLINATIONS_KEY=              # gratis: enter.pollinations.ai — también sirve para imágenes
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ===== Stock de imágenes/videos (opcional en M1) =====
PEXELS_API_KEY=

